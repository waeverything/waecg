{
  "name": "waecg",
  "type": "module",
  "scripts": {
    "build": "npm run build:graphics && npm run build:dashboard",
    "build:graphics": "vite build --config vite.graphics.config.js",
    "build:dashboard": "vite build --config vite.dashboard.config.js"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "nodecg": "^2.8.0",
    "three": "^0.185.1",
    "two.js": "^0.8.23"
  },
  "nodecg": {
    "compatibleRange": ">=2.8",
    "assetCategories": [
      {
        "name": "intermission-logo",
        "title": "Intermission Logo",
        "allowedTypes": [
          "png",
          "jpg",
          "jpeg",
          "svg",
          "webp"
        ]
      }
    ],
    "dashboardPanels": [
      {
        "name": "clock",
        "title": "Clock",
        "width": 2,
        "file": "clock.html"
      },
      {
        "name": "schedule",
        "title": "Schedule",
        "width": 4,
        "file": "schedule.html"
      },
      {
        "name": "toasts",
        "title": "Toasts",
        "width": 4,
        "file": "toasts.html"
      },
      {
        "name": "widget",
        "title": "Widget",
        "width": 2,
        "file": "widget.html"
      }
    ],
    "graphics": [
      {
        "file": "schedule.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "toasts.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "intermission.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "widget.html",
        "width": 1920,
        "height": 1080
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "glob": "^13.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
